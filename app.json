{
  "expo": {
    "name": "LanguageCoach",
    "slug": "language-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.yourname.languagecoach",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "androidMode": "default"
        }
      ],
      "./android-manifest.plugin",
      [
        "expo-av",
        {
          "microphonePermission": "Allow LanguageCoach to access your microphone."
        }
      ]
    ]
  }
}